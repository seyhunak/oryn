# ORYN configuration. Copy to `.env` (read by the Makefile and docker compose).
# Every variable is optional for local development unless marked REQUIRED.

# --- Control plane (oryn-api) -------------------------------------------------
# REQUIRED in production: Postgres 15+ with the pgvector extension.
DATABASE_URL=postgres://oryn:oryn@localhost:55433/oryn
# Optional: shared rate limiting across replicas. Without it limits are per process.
REDIS_URL=redis://localhost:56380
# REQUIRED in production: at least 32 random characters. Encrypts stored credentials
# (environment secrets, provider keys, repository tokens). Changing it makes existing
# secrets unreadable. Generate one with: openssl rand -base64 48
ORYN_SECRET_KEY=change-me-to-a-long-random-secret-key-0123
ORYN_BIND=0.0.0.0:8080
# The URL users open in the browser (OIDC redirects, links in notifications).
ORYN_PUBLIC_URL=http://localhost:3000
# Set true behind HTTPS so the session cookie is marked Secure.
ORYN_COOKIE_SECURE=false
ORYN_SESSION_TTL_HOURS=168
# Allow self-registration after the first (admin) account exists.
ORYN_ALLOW_REGISTRATION=true
# Workers present this once to register themselves. Leave empty to require
# admin-created worker tokens only.
ORYN_WORKER_BOOTSTRAP_TOKEN=dev-worker-bootstrap-token
ORYN_JOB_LEASE_SECS=60
ORYN_ARTIFACT_DIR=./data/artifacts
ORYN_WORKSPACE_DIR=./data/repos
ORYN_MAX_ARTIFACT_BYTES=104857600
ORYN_MAX_UPLOAD_BYTES=209715200
# Directory that "local" repository imports may read from (unset disables them).
ORYN_LOCAL_IMPORT_ROOT=
# SSRF guard: outbound calls (git clones, webhooks, model endpoints) to private,
# loopback and link-local addresses are refused unless this is true. Cloud metadata
# addresses are always refused. Set it to true for a local Ollama or a self-hosted
# GitLab on your network. Hosts are resolved once and the connection is pinned to the
# checked address, so DNS rebinding cannot get around this.
ORYN_ALLOW_PRIVATE_NETWORK=false
# Comma-separated origins allowed to call the API cross-origin (the web UI proxies
# /api, so this is normally empty).
ORYN_CORS_ORIGINS=
# Peers allowed to set X-Forwarded-For (IPs or CIDRs, comma-separated). Empty = loopback and
# private ranges, which covers the bundled web server; "none" ignores the header from everyone.
ORYN_TRUSTED_PROXIES=
# Browser recording needs a Playwright runner that can open a headed browser.
ORYN_RECORDER_URL=
ORYN_RECORDER_TOKEN=

# Single sign-on (OpenID Connect, authorization code + PKCE). Both issuer and client id
# enable it.
ORYN_OIDC_ISSUER=
ORYN_OIDC_CLIENT_ID=
ORYN_OIDC_CLIENT_SECRET=
ORYN_OIDC_SCOPES=openid email profile
ORYN_OIDC_NAME=Single sign-on

# --- Observability --------------------------------------------------------------
RUST_LOG=info,oryn=debug
# json or pretty
ORYN_LOG_FORMAT=pretty
# Export traces with OTLP/HTTP when set, e.g. http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Worker (oryn-worker) ---------------------------------------------------------
ORYN_API_URL=http://localhost:8080
# Either a token created in Workers → Add worker, or leave empty and use the
# bootstrap token above to self-register (the token is then saved to the file below).
ORYN_WORKER_TOKEN=
ORYN_WORKER_TOKEN_FILE=./data/worker-token
ORYN_WORKER_NAME=
ORYN_WORKER_CONCURRENCY=2
ORYN_WORKER_LABELS=
ORYN_WORKER_POLL_MS=2000
# Browser jobs are sent to this Playwright runner; without it the worker runs API jobs only.
ORYN_RUNNER_URL=http://localhost:7400
ORYN_RUNNER_TOKEN=

# --- Web (apps/web) ---------------------------------------------------------------
# Where the Next.js server proxies /api (build-time for the standalone image).
ORYN_API_INTERNAL_URL=http://localhost:8080

# --- AI providers -----------------------------------------------------------------
# Providers and their keys are configured per workspace in Settings → AI models and
# stored encrypted. ORYN works fully without any provider.

# ── Docker Compose host ports (all bound to 127.0.0.1) ──
# Change these when something else on your machine already uses a port.
ORYN_WEB_PORT=3000
ORYN_API_PORT=8080
ORYN_DEMO_PORT=4000
ORYN_PG_PORT=55433
ORYN_REDIS_PORT=56380
